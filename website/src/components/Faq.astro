---
import { faq } from "../data/site";
---

<section id="faq" class="py-20">
  <div class="mx-auto max-w-3xl px-6">
    <h2 class="text-center font-display text-3xl font-bold text-primary-text md:text-4xl">
      Frequently asked questions
    </h2>

    <div class="mt-10 divide-y divide-black/5">
      {
        faq.map((item) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between font-display font-semibold text-primary-text">
              {item.question}
              <span class="ml-4 text-primary transition group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-sm text-secondary-text">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
