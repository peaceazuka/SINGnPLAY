---
import { pricing } from "../data/site";
---

<section id="pricing" class="bg-secondary-bg py-20">
  <div class="mx-auto max-w-6xl px-6">
    <h2 class="text-center font-display text-3xl font-bold text-primary-text md:text-4xl">
      {pricing.heading}
    </h2>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {
        pricing.plans.map((plan) => (
          <div
            class:list={[
              "flex flex-col rounded-3xl p-8 shadow-sm",
              plan.featured ? "bg-primary text-white ring-4 ring-primary/20" : "bg-primary-bg text-primary-text",
            ]}
          >
            <p class="font-display text-lg font-bold">{plan.name}</p>
            <p class="mt-4">
              <span class="font-display text-3xl font-bold">{plan.price}</span>
              <span class:list={["text-sm", plan.featured ? "text-white/80" : "text-secondary-text"]}>
                {" "}{plan.period}
              </span>
            </p>
            <p class:list={["mt-3 text-sm", plan.featured ? "text-white/90" : "text-secondary-text"]}>
              {plan.description}
            </p>
            <a
              href="#"
              class:list={[
                "mt-6 rounded-full px-6 py-3 text-center text-sm font-bold transition",
                plan.featured ? "bg-white text-primary hover:opacity-90" : "bg-primary text-white hover:opacity-90",
              ]}
            >
              {plan.cta}
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>
