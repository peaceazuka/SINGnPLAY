---
import { testimonials } from "../data/site";
---

<section class="py-20">
  <div class="mx-auto max-w-6xl px-6">
    <h2 class="text-center font-display text-3xl font-bold text-primary-text md:text-4xl">
      Loved by families and churches
    </h2>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {
        testimonials.map((t) => (
          <figure class="rounded-3xl bg-secondary-bg p-7 shadow-sm">
            <blockquote class="text-secondary-text">{t.quote}</blockquote>
            <figcaption class="mt-4 font-display text-sm font-bold text-primary-text">
              {t.name}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
