---
import { gamification } from "../data/site";
---

<section class="bg-alternate py-20">
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-6 md:grid-cols-2">
    <div>
      <h2 class="font-display text-3xl font-bold text-primary-text md:text-4xl">
        {gamification.heading}
      </h2>
      <div class="mt-8 grid grid-cols-3 gap-4">
        {
          gamification.stats.map((stat) => (
            <div class="rounded-2xl bg-secondary-bg p-4 text-center shadow-sm">
              <p class="font-display text-2xl font-bold text-primary">{stat.value}</p>
              <p class="mt-1 text-xs font-semibold uppercase tracking-wide text-secondary-text">
                {stat.label}
              </p>
            </div>
          ))
        }
      </div>
    </div>

    <div class="rounded-3xl bg-secondary-bg p-8 shadow-md">
      <p class="text-xs font-bold uppercase tracking-wide text-secondary">{gamification.challengeTitle}</p>
      <p class="mt-3 font-display text-xl font-semibold text-primary-text">
        {gamification.challengeDescription}
      </p>
      <div class="mt-6 flex items-center gap-2 text-tertiary">
        <span class="text-2xl">⭐</span>
        <span class="text-2xl">⭐</span>
        <span class="text-2xl">⭐</span>
      </div>
    </div>
  </div>
</section>
