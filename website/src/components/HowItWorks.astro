---
import { howItWorks } from "../data/site";
---

<section id="how-it-works" class="py-20">
  <div class="mx-auto max-w-6xl px-6">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="font-display text-3xl font-bold text-primary-text md:text-4xl">How it works</h2>
      <p class="mt-3 text-secondary-text">Three steps to your family's first sing-along.</p>
    </div>

    <div class="mt-12 grid gap-8 md:grid-cols-3">
      {
        howItWorks.map((item) => (
          <div class="rounded-3xl bg-secondary-bg p-8 text-center shadow-sm">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-primary font-display text-lg font-bold text-white">
              {item.step}
            </div>
            <h3 class="mt-5 font-display text-lg font-bold text-primary-text">{item.title}</h3>
            <p class="mt-2 text-sm text-secondary-text">{item.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
