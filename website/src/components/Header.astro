---
import { brand, storeBadges, hero } from "../data/site";
---

<header class="sticky top-0 z-50 bg-primary-bg/90 backdrop-blur border-b border-black/5">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href="/" class="font-display text-xl font-bold text-primary">{brand.name}</a>
    <nav class="hidden gap-8 text-sm font-semibold text-primary-text md:flex">
      <a href="#how-it-works" class="hover:text-primary">How it works</a>
      <a href="#songs" class="hover:text-primary">Songs</a>
      <a href="#pricing" class="hover:text-primary">Pricing</a>
      <a href="#faq" class="hover:text-primary">FAQ</a>
    </nav>
    <a
      href={storeBadges.appStoreUrl}
      class="rounded-full bg-primary px-5 py-2 text-sm font-bold text-white shadow-sm transition hover:opacity-90"
    >
      {hero.ctaLabel}
    </a>
  </div>
</header>
